# REQUIRE SD
# REQUIRE VER 4.0.0

# One-shot offline removal for interface translation files locked by Horizon.
goHekate = {
    delfile("sd:/startup.te")
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    if (fsexists("sd:/bootloader/update.bin")) {
        delfile("sd:/payload.bin")
        copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
    }
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc) {
        if (fsexists("sd:/payload.bin")) {
            rc = payload("sd:/payload.bin")
        }
    }
    if (rc) {
        if (fsexists("sd:/bootloader/payloads/hekate.bin")) {
            rc = payload("sd:/bootloader/payloads/hekate.bin")
        }
    }
    if (rc) {
        reboot()
    }
}

clear()
delfile("sd:/startup.te")
println("Removing interface translation...")

deldir("sd:/atmosphere/contents/010000000000080B")
deldir("sd:/atmosphere/contents/010000000000080C")
deldir("sd:/atmosphere/contents/010000000000100D")
deldir("sd:/atmosphere/contents/0100000000000803")
deldir("sd:/atmosphere/contents/0100000000000811")
deldir("sd:/atmosphere/contents/0100000000001000/romfs/message")
deldir("sd:/atmosphere/contents/0100000000001001")
deldir("sd:/atmosphere/contents/0100000000001002")
deldir("sd:/atmosphere/contents/0100000000001003")
deldir("sd:/atmosphere/contents/0100000000001004")
deldir("sd:/atmosphere/contents/0100000000001005")
deldir("sd:/atmosphere/contents/0100000000001006")
deldir("sd:/atmosphere/contents/0100000000001007")
deldir("sd:/atmosphere/contents/0100000000001008")
deldir("sd:/atmosphere/contents/0100000000001009")
deldir("sd:/atmosphere/contents/0100000000001012")
deldir("sd:/atmosphere/contents/0100000000001013")
deldir("sd:/atmosphere/contents/0100000000001015")

ok = 1
if (fsexists("sd:/atmosphere/contents/010000000000080B")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/010000000000080C")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/010000000000100D")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000000803")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000000811")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001000/romfs/message")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001001")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001002")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001003")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001004")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001005")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001006")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001007")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001008")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001009")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001012")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001013")) { ok = 0 }
if (fsexists("sd:/atmosphere/contents/0100000000001015")) { ok = 0 }

if (ok) {
    color(0x00FF00)
    println("Interface translation removed successfully.")
} .else() {
    color(0xFF0000)
    println("ERROR: Some translation files could not be removed.")
}
color(0xFFFFFF)
println("Returning to Hekate in 3 seconds...")
sleep(3000)
goHekate()
