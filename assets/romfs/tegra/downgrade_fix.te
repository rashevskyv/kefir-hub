# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# DowngradeFix.te - Dual-mode Downgrade Fix
# Deletes system save 8000000000000073 from SYSTEM partition to prevent downgrade protection.
# Supports automated Kefir Hub launch and manual TegraExplorer launch.

goHekate = {
    println("Cleaning temp flags...")
    delfile("sd:/startup.te")
    delfile("sd:/config/kefir/downgrade_nand")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        delfile("sd:/bootloader/hekate_ipl.ini")
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    if (fsexists("sd:/bootloader/update.bin")) {
        println("Restoring Hekate (payload.bin)...")
        delfile("sd:/payload.bin")
        copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
    }
    println("Loading Hekate (bootloader/update.bin, payload.bin)...")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc) {
        if (fsexists("sd:/payload.bin")) {
            rc = payload("sd:/payload.bin")
        }
    }
    if (rc) {
        if (fsexists("sd:/bootloader/payloads/hekate.bin")) {
            rc = payload("sd:/bootloader/payloads/hekate.bin")
        }
    }
    if (rc) {
        if (fsexists("sd:/atmosphere/reboot_payload.bin")) {
            rc = payload("sd:/atmosphere/reboot_payload.bin")
        }
    }
    if (rc) {
        color(0xFF0000)
        println("Hekate payload not found (bootloader/update.bin, payload.bin).")
        color(0xFFFFFF)
        println("Rebooting in 3 seconds...")
        sleep(3000)
        reboot()
    }
}

flagf = "sd:/config/kefir/downgrade_nand"
isHub = 0
target = ""

if (fsexists(flagf)) {
    isHub = 1
    raw = readfile(flagf)
    target = raw.bytestostr()
    delfile(flagf)
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        delfile("sd:/bootloader/hekate_ipl.ini")
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    if (fsexists("sd:/bootloader/update.bin")) {
        delfile("sd:/payload.bin")
        copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
    }
}

fail = {
    color(0xFF0000)
    println("[ERROR] ", failMsg)
    color(0xFFFFFF)
    if (isHub) {
        println("Returning to Hekate in 5 seconds...")
        sleep(5000)
        goHekate()
    } .else() {
        println("Press any key to exit")
        pause()
    }
    exit()
}

if (isHub) {
    clear()
    color(0x00FFFF)
    println("=== Kefir Hub: Downgrade Fix ===")
    color(0xFFFFFF)
    println()

    validTarget = 0
    if (target == "emu") {
        validTarget = 1
    }
    if (target == "sys") {
        validTarget = 1
    }
    if (!validTarget) {
        fail(failMsg = "Invalid downgrade target in downgrade_nand")
    }
} .else() {
    clear()
    color(0x00FFFF)
    println("=== Switch Downgrade Fix ===")
    println("This script will delete the 8000000000000073 save file")
    println("from the SYSTEM partition to prevent downgrade protection.")
    println()
    color(0xFFFFFF)

    println("Select target:")
    choice = menu(["Exit", "Sysmmc", "Emummc"], 0)

    if (choice == 0) {
        exit()
    }

    if (choice == 1) {
        target = "sys"
    } .else() {
        target = "emu"
    }

    clear()
    color(0x00FFFF)
    println("=== Downgrade Fix Confirmation ===")
    color(0xFFFFFF)
    if (target == "sys") {
        println("Target: Sysmmc")
    } .else() {
        println("Target: Emummc")
    }
    println("Action: Delete 8000000000000073")
    println()
    color(0xFFFF00)
    println("WARNING: This will modify your SYSTEM partition!")
    println("Make sure you know what you are doing before proceeding!")
    println()
    color(0xFFFFFF)

    println("Press POWER to continue, any other key to exit")
    if (!pause().power) {
        exit()
    }
    clear()
}

mountRc = 1
if (target == "emu") {
    println("Mounting emuMMC SYSTEM partition...")
    if (!emu()) {
        fail(failMsg = "No emuMMC found on SD card!")
    }
    mountRc = mountemu("SYSTEM")
} .else() {
    println("Mounting sysMMC SYSTEM partition...")
    mountRc = mountsys("SYSTEM")
}

if (mountRc) {
    fail(failMsg = "Failed to mount SYSTEM partition!")
}

targetSave = "bis:/save/8000000000000073"

if (!fsexists(targetSave)) {
    color(0xFFFF00)
    println("System save 8000000000000073 not found (already clean).")
    color(0xFFFFFF)
} .else() {
    println("Deleting 8000000000000073...")
    delRc = delfile(targetSave)
    if (delRc) {
        fail(failMsg = "Failed to delete 8000000000000073!")
    }
    if (fsexists(targetSave)) {
        fail(failMsg = "File deletion failed - 8000000000000073 still exists!")
    }
    color(0x00FF00)
    println("SUCCESS: 8000000000000073 has been deleted!")
    color(0xFFFFFF)
}

println()
color(0x00FF00)
println("Downgrade fix completed successfully!")
color(0xFFFFFF)

if (isHub) {
    println("Returning to Hekate in 3 seconds...")
    sleep(3000)
    goHekate()
} .else() {
    println("Press any key to exit")
    pause()
}
