# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# Hub copies this to sd:/startup.te after Restore Backup.
# Writes merged PlayEvent.dat into 00F0, then loads hekate.

goHekate = {
    saveObj = dict()
    bytes = ["BYTE[]"]
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc) {
        println("Could not load hekate", rc)
        pause()
    }
}

clear()
println("Kefir Hub: restore play hours")
println("")

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

pending = "sd:/config/kefir/playtime_pending/PlayEvent.dat"
if (!fsexists(pending)) {
    println("No pending PlayEvent.dat")
    goHekate()
    exit()
}

if (emu()) {
    rc = mountemu("SYSTEM")
} .else() {
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

bis = "bis:/save/80000000000000F0"
if (!fsexists(bis)) {
    println("No play-hours save on this SYSTEM")
    goHekate()
    exit()
}

println("Reading pending PlayEvent.dat")
bytes = readfile(pending)
println("Opening 00F0")
saveObj = readsave(bis)
println("Writing PlayEvent.dat")
rc = saveObj.write("/PlayEvent.dat", bytes)
if (rc) {
    println("write fail", rc)
    goHekate()
    exit()
}
println("commit")
saveObj.commit()
println("Play hours written. Loading hekate.")
goHekate()
