# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# One-shot: Hub copies this to sd:/startup.te and reboots into TegraExplorer.
# Dumps account save 0010, deletes startup.te, loads hekate.

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    lines = []
    bytes = ["BYTE[]"]
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc) {
        reboot()
    }
}

clear()
println("Kefir Hub: dumping account save 0010")
println("")

pending = "sd:/config/kefir/restore_pending"
dst = combinepath(pending, "0010")
listf = combinepath(pending, "files.txt")

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

if (!fsexists(listf)) {
    println("No file list from Kefir Hub.")
    goHekate()
    exit()
}

if (emu()) {
    rc = mountemu("SYSTEM")
} .else() {
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

bis = "bis:/save/8000000000000010"
if (!fsexists(bis)) {
    println("No account save on this SYSTEM")
    goHekate()
    exit()
}

mkdir(pending)
mkdir(dst)
mkdir(combinepath(dst, "su"))
mkdir(combinepath(dst, "su/baas"))
mkdir(combinepath(dst, "su/nas"))
mkdir(combinepath(dst, "su/avators"))

println("Opening 0010")
saveObj = readsave(bis)
raw = readfile(listf)
text = raw.bytestostr()
lines = text.split("\n")
wrote = 0
lines.foreach("line") {
    if (line.len()) {
        bytes = saveObj.read(line)
        if (bytes.len()) {
            out = dst + line
            parent = escapepath(out)
            mkdir(parent)
            rc = writefile(out, bytes)
            if (!rc) {
                wrote = wrote + 1
            }
        }
    }
}

dumpSaveFolder = {
    listing = saveObj.readdir(saveRel)
    if (!listing.result) {
        files = listing.files.copy()
        files.foreach("fname") {
            fpath = saveRel + "/" + fname
            bytes = saveObj.read(fpath)
            if (bytes.len()) {
                out = dst + fpath
                parent = escapepath(out)
                mkdir(parent)
                rc = writefile(out, bytes)
                if (!rc) {
                    wrote = wrote + 1
                }
            }
        }
    }
}
saveRel = "/su/baas"
dumpSaveFolder()
saveRel = "/su/nas"
dumpSaveFolder()
saveRel = "/baas"
dumpSaveFolder()
saveRel = "/nas"
dumpSaveFolder()

writefile(combinepath(pending, "dumped.ok"), ["BYTE[]", 79, 75])
println("wrote", wrote)
println("Open Kefir Hub to continue restore.")
goHekate()
