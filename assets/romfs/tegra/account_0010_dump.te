# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# One-shot: Hub copies this to sd:/startup.te and reboots into TegraExplorer.
# Copies raw BIS account save 8000000000000010 (no unpack), then loads hekate.

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    lines = []
    bytes = ["BYTE[]"]
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc) {
        reboot()
    }
}

clear()
println("Kefir Hub: dumping account save 0010")
println("")

pending = "sd:/config/kefir/restore_pending"
snap = combinepath(pending, "8000000000000010")
nandf = combinepath(pending, "nand")
bis = "bis:/save/8000000000000010"

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

mkdir(pending)

if (emu()) {
    println("NAND: emuMMC SYSTEM")
    writefile(nandf, ["BYTE[]", 101, 109, 117])
    rc = mountemu("SYSTEM")
} .else() {
    println("NAND: sysMMC SYSTEM")
    writefile(nandf, ["BYTE[]", 115, 121, 115])
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

if (!fsexists(bis)) {
    println("No account save on this SYSTEM")
    goHekate()
    exit()
}

if (fsexists(snap)) {
    delfile(snap)
}

println("Copying raw", bis)
rc = copyfile(bis, snap)
if (rc) {
    println("copyfile failed", rc)
    goHekate()
    exit()
}
if (!fsexists(snap)) {
    println("Snapshot missing after copy")
    goHekate()
    exit()
}

writefile(combinepath(pending, "dumped.ok"), ["BYTE[]", 79, 75])
println("Raw 0010 copied to SD.")
println("Open Kefir Hub to continue restore.")
goHekate()
