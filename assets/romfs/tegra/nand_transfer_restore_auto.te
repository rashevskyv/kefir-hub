# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# One-shot: Hub writes restore_pending/nand + nand_pack.txt, copies this to
# sd:/startup.te. Mounts that SYSTEM, readsave + writeDir pack inner files into
# existing 0010/0011/00F0/0041, commit() with this console's prod.keys, then
# loads hekate. Does NOT copy raw SYSTEM:/save blobs onto BIS.

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    lines = []
    bytes = ["BYTE[]"]
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc) {
        reboot()
    }
}

writeDir = {
    src = srcRoot
    if (rel.len()) {
        src = srcRoot + "/" + rel
    }
    listing = readdir(src)
    if (listing.result) {
        println("readdir fail", src)
        errors = errors + 1
    } .else() {
        files = listing.files.copy()
        subs = listing.folders.copy()
        files.foreach("fname") {
            fsrc = combinepath(src, fname)
            fdst = "/" + fname
            if (rel.len()) {
                fdst = "/" + rel + "/" + fname
            }
            println(fdst)
            bytes = readfile(fsrc)
            rc = saveObj.write(fdst, bytes)
            if (rc) {
                println("write fail", fdst, rc)
                errors = errors + 1
            } .else() {
                wrote = wrote + 1
            }
        }
        subs.foreach("dname") {
            oldrel = rel
            if (rel.len()) {
                rel = rel + "/" + dname
            } .else() {
                rel = dname
            }
            writeDir()
            rel = oldrel
        }
    }
}

restoreOne = {
    srcRoot = combinepath(pack, saveId)
    if (!fsexists(srcRoot)) {
        println("skip pack", saveId)
    } .else() {
        bis = combinepath("bis:/save", saveId)
        if (!fsexists(bis)) {
            println("skip dest (no blob, will not create)", bis)
            errors = errors + 1
        } .else() {
            println("open", bis)
            saveObj = readsave(bis)
            rel = ""
            err_before = errors
            writeDir()
            if (errors > err_before) {
                println("skip commit", saveId, "write errors")
            } .else() {
                println("commit", saveId)
                saveObj.commit()
                restored = restored + 1
            }
        }
    }
}

clear()
println("Kefir Hub: restore profiles & play hours")
println("Encrypts pack files with THIS console keys, then signs.")
println("")

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

pending = "sd:/config/kefir/restore_pending"
nandf = combinepath(pending, "nand")
packf = combinepath(pending, "nand_pack.txt")

if (!fsexists(nandf)) {
    println("No NAND flag (emu/sys)")
    println(nandf)
    goHekate()
    exit()
}
if (!fsexists(packf)) {
    println("No pack path file")
    println(packf)
    goHekate()
    exit()
}

raw = readfile(nandf)
text = raw.bytestostr()
if (text == "emu") {
    println("NAND flag: emuMMC SYSTEM")
    if (!emu()) {
        println("No emuMMC")
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (text != "sys") {
        println("Bad NAND flag", text)
        goHekate()
        exit()
    }
    println("NAND flag: sysMMC SYSTEM")
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

raw = readfile(packf)
rel = raw.bytestostr()
pack = "sd:" + rel
println("pack:", pack)

if (!fsexists(pack)) {
    println("Pack folder missing")
    goHekate()
    exit()
}
if (!fsexists(combinepath(pack, "80000000000000F0")) && !fsexists(combinepath(pack, "8000000000000010"))) {
    println("Not a profiles & play hours pack")
    goHekate()
    exit()
}

wrote = 0
errors = 0
restored = 0
do00F0 = 1
flagf = combinepath(pending, "restore_00F0")
if (fsexists(flagf)) {
    raw = readfile(flagf)
    text = raw.bytestostr()
    if (text == "0") {
        do00F0 = 0
        println("Play hours flag: skip 00F0")
    }
}
ids = ["8000000000000010", "8000000000000011", "80000000000000F0", "8000000000000041"]
ids.foreach("saveId") {
    if (saveId == "80000000000000F0") {
        if (do00F0) {
            restoreOne()
        } .else() {
            println("skip play hours (restore_00F0=0)")
        }
    } .else() {
        restoreOne()
    }
}

println("")
println("wrote", wrote, "errors", errors, "saves", restored)
if (errors || !restored) {
    println("Restore incomplete. Raw 0010/00F0 snapshots kept for Undo if present.")
    println("If Atmosphere fails to boot: hekate SYSTEM restore or Undo_restore_if_wont_boot.te")
    goHekate()
    exit()
}

writefile(combinepath(pending, "nand_restored.ok"), ["BYTE[]", 79, 75])
println("Profiles & play hours restored.")
println("Loading hekate.")
goHekate()
