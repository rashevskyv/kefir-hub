}

restoreSave00F0 = {
    curSaveId = "80000000000000F0"
    curSaveShort = "00F0"
    packSaveDir = pack + "/" + curSaveId
    bis = "bis:/save/" + curSaveId

    if (!do00F0) {
        stat00F0 = "[SKIPPED] (Disabled by flag)"
        col00F0 = 0x666666
        drawDashboard()
    } .else() {
        if (!fsexists(packSaveDir)) {
            stat00F0 = "[SKIPPED] (Not in pack)"
            col00F0 = 0x666666
            drawDashboard()
        } .else() {
            if (!fsexists(bis)) {
                stat00F0 = "[FAIL] (Target save missing)"
                col00F0 = 0xFF0000
                drawDashboard()
                errors = errors + 1
            } .else() {
                clear()
                stat00F0 = "[IN PROGRESS]"
                col00F0 = 0xFFFF00
                drawDashboard()
                logY = 14

                msg = "  [*] Opening save 80000000000000F0 (Play Hours)..."
                colLog = 0x00FFFF
                logMsg()
                upd_s()

                saveObj = readsave(bis)
                saveFilesDone = 0
                saveErrors = 0

                curDir = "/"
                restoreFilesInDir()

                if (saveErrors == 0) {
                    msg = "  [*] Committing 80000000000000F0..."
                    colLog = 0xFFFF00
                    logMsg()
                    upd_s()
                    commitRc = saveObj.commit()
                    if (commitRc) {
                        errors = errors + 1
                        saveErrors = saveErrors + 1
                        stat00F0 = "[FAILED] (Commit rc=" + commitRc.str() + ")"
                        col00F0 = 0xFF0000
                        msg = "  [FAIL] Commit failed: 80000000000000F0 rc=" + commitRc.str()
                        colLog = 0xFF0000
                        logMsg()
                    } .else() {
                        stat00F0 = "[RESTORED] (" + saveFilesDone.str() + " files)"
                        col00F0 = 0x00FF00
                        restoredSaves = restoredSaves + 1
                        msg = "  [OK] Play hours committed successfully!"
                        colLog = 0x00FF00
                        logMsg()
                    }
                    upd_s()
                    saveObj.close()
                    saveObj = 0
                } .else() {
                    saveObj.close()
                    saveObj = 0
                    stat00F0 = "[FAILED] (" + saveErrors.str() + " errors)"
                    col00F0 = 0xFF0000
                    msg = "  [FAIL] Errors during restore, commit skipped!"
                    colLog = 0xFF0000
                    logMsg()
                }
                drawDashboard()
            }
        }
    }
}

# ------------------------------------------------------------------------------
# MAIN ENTRY POINT
# ------------------------------------------------------------------------------

clear()
color(0x00FFFF)
println("=============================================================================")
println(" TegraExplorer: Profiles and Playtime Restore                                ")
println("=============================================================================")
println("")
color(0xFFFFFF)

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

pending = "sd:/config/kefir/restore_pending"
delfile(pending + "/nand_restored.ok")

nandf = pending + "/nand"
packf = pending + "/nand_pack.txt"

# 1. Require NAND target flag
if (!fsexists(nandf)) {
    color(0xFF0000)
    println("ERROR: Missing NAND target flag: ", nandf)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

raw = readfile(nandf)
nandType = raw.bytestostr()

if (nandType == "emu") {
    println("NAND Target: emuMMC SYSTEM")
    targetName = "emuMMC SYSTEM"
    if (!emu()) {
        color(0xFF0000)
        println("ERROR: No emuMMC found on SD!")
        color(0xFFFFFF)
        pause()
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (nandType == "sys") {
        println("NAND Target: sysMMC SYSTEM")
        targetName = "sysMMC SYSTEM"
        rc = mountsys("SYSTEM")
    } .else() {
        color(0xFF0000)
        println("ERROR: Invalid NAND flag: ", nandType)
        color(0xFFFFFF)
        pause()
        goHekate()
        exit()
    }
}

if (rc) {
    color(0xFF0000)
    println("ERROR: SYSTEM partition mount failed rc: ", rc)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

# 2. Require and validate exact pack path (direct child of /config/kefir/nand_transfer)
if (!fsexists(packf)) {
    color(0xFF0000)
    println("ERROR: Missing pack path file: ", packf)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

raw = readfile(packf)
rel = raw.bytestostr()

if (rel.len() == 0) {
    color(0xFF0000)
    println("ERROR: Pack path file is empty!")
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

bks = rel.split("\\")
if (bks.len() != 1) {
    color(0xFF0000)
    println("ERROR: Pack path contains backslash: ", rel)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

parts = rel.split("/")
if (parts.len() != 5) {
    color(0xFF0000)
    println("ERROR: Malformed pack path structure: ", rel)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

if (parts[0] != "" || parts[1] != "config" || parts[2] != "kefir" || parts[3] != "nand_transfer") {
    color(0xFF0000)
    println("ERROR: Pack path outside /config/kefir/nand_transfer: ", rel)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

packNameShort = parts[4]
if (packNameShort.len() == 0 || packNameShort == "." || packNameShort == "..") {
    color(0xFF0000)
    println("ERROR: Invalid pack folder name: ", packNameShort)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

pack = "sd:" + rel

if (!fsexists(pack)) {
    color(0xFF0000)
    println("ERROR: Selected pack directory does not exist: ", pack)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

if (!fsexists(pack + "/8000000000000010") && !fsexists(pack + "/80000000000000F0")) {
    color(0xFF0000)
    println("ERROR: Not a valid profiles & play hours pack: ", pack)
    color(0xFFFFFF)
    pause()
    goHekate()
    exit()
}

# 3. Play Hours Flag Check
do00F0 = 1
flagf = pending + "/restore_00F0"
if (fsexists(flagf)) {
    raw = readfile(flagf)
    flagText = raw.bytestostr()
    if (flagText == "0") {
        do00F0 = 0
        println("Play hours flag: skip 00F0")
    }
}

# 4. Check Hub Undo Safety Snapshots
snap0010 = pending + "/8000000000000010"
snap00F0 = pending + "/80000000000000F0"
hasSnap0010 = fsexists(snap0010)
hasSnap00F0 = fsexists(snap00F0)
needsSnap0010 = fsexists(pack + "/8000000000000010")
needsSnap00F0 = do00F0 && fsexists(pack + "/80000000000000F0")
hasRelevantSnap = (needsSnap0010 && hasSnap0010) || (needsSnap00F0 && hasSnap00F0)

hubSnapOk = needsSnap0010 || needsSnap00F0
if (needsSnap0010 && !hasSnap0010) {
    hubSnapOk = 0
}
if (needsSnap00F0 && !hasSnap00F0) {
    hubSnapOk = 0
}

if (hubSnapOk) {
    statBackup = "[RETAINED] restore_pending"
    colBackup = 0x00FF00
} .else() {
    if (hasRelevantSnap) {
        statBackup = "[PARTIAL] restore_pending"
        colBackup = 0xFFFF00
    } .else() {
        statBackup = "[WARN] None (use Hekate)"
        colBackup = 0xFFFF00
    }
}

wrote = 0
errors = 0
restoredSaves = 0
expectedSaves = 0

if (needsSnap0010) {
    expectedSaves = expectedSaves + 1
}
if (fsexists(pack + "/8000000000000011")) {
    expectedSaves = expectedSaves + 1
}
if (needsSnap00F0) {
    expectedSaves = expectedSaves + 1
}

curFileName = ""
curFileIdx = 0
curDirTotal = 0
curDir = ""
curSaveId = ""
curSaveShort = ""
stat0010 = "[PENDING]"
col0010 = 0x666666
stat0011 = "[PENDING]"
col0011 = 0x666666
stat00F0 = "[PENDING]"
col00F0 = 0x666666

clear()
drawDashboard()
logY = 14

if (hubSnapOk) {
    msg = "  [i] Hub Undo snapshot verified in restore_pending."
    colLog = 0x00FF00
    logMsg()
} .else() {
    if (hasRelevantSnap) {
        msg = "  [WARN] Partial Hub snapshot in restore_pending (check Hekate backup)."
        colLog = 0xFFFF00
        logMsg()
    } .else() {
        msg = "  [WARN] No Hub snapshot in restore_pending! Rely on Hekate backup."
        colLog = 0xFFFF00
        logMsg()
    }
}

# 1. Restore 0010 (Accounts/Profiles)
restoreSave0010()

# 2. Restore 0011 (User ID Generator)
restoreSave0011()

# 3. Restore 00F0 (Play Hours)
restoreSave00F0()

# Keep earlier error messages visible on the final screen.
println("Files written: ", wrote, " Errors: ", errors, " Saves committed: ", restoredSaves)

if (errors == 0 && restoredSaves > 0 && restoredSaves == expectedSaves) {
    writefile(pending + "/nand_restored.ok", ["BYTE[]", 79, 75])
    colLog = 0x00FF00
    msg = "=== RESTORE COMPLETED SUCCESSFULLY! ==="
    logMsg()
    msg = "User profiles, accounts, and play hours are now restored."
    logMsg()
} .else() {
    colLog = 0xFF0000
    msg = "=== WARNING: RESTORE COMPLETED WITH ERRORS! ==="
    logMsg()
    msg = "Check logs above. Failed saves were not committed."
    logMsg()
    if (hasRelevantSnap) {
        msg = "Hub Undo snapshot retained: restore_pending/"
        logMsg()
        msg = "If console won't boot: run Undo_restore_if_wont_boot.te"
        logMsg()
    } .else() {
        msg = "No Hub Undo snapshot. Restore Hekate SYSTEM backup if needed."
        logMsg()
    }
}

colLog = 0xFFFFFF
msg = ""
logMsg()
if (hasRelevantSnap) {
    msg = "Hub Undo snapshot: restore_pending/"
    logMsg()
} .else() {
    msg = "No Hub Undo snapshot; rely on Hekate SYSTEM backup."
    logMsg()
}
msg = "Press A to reboot to Hekate"
logMsg()

spinner(0)
pause()
goHekate()
