# ------------------------------------------------------------------------------
# MAIN ENTRY POINT
# ------------------------------------------------------------------------------

clear()
color(0x00FFFF)
println("=============================================================================")
println(" TegraExplorer: Profiles and Playtime Restore v0.13.801                       ")
println("=============================================================================")
println("")
color(0xFFFFFF)

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    delfile("sd:/bootloader/hekate_ipl.ini")
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
    delfile("sd:/bootloader/hekate_ipl.ini.bak")
}
delfile("sd:/config/kefir/hekate-payload-request.ini")
if (fsexists("sd:/bootloader/update.bin")) {
    delfile("sd:/payload.bin")
    copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
}

pending = "sd:/config/kefir/restore_pending"
delfile(pending + "/nand_restored.ok")

nandf = pending + "/nand"
packf = pending + "/nand_pack.txt"

# 1. Require NAND target flag
if (!fsexists(nandf)) {
    color(0xFF0000)
    println("ERROR: Missing NAND target flag: ", nandf)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

raw = readfile(nandf)
nandType = raw.bytestostr()

if (nandType == "emu") {
    println("NAND Target: emuMMC SYSTEM")
    targetName = "emuMMC SYSTEM"
    if (!emu()) {
        color(0xFF0000)
        println("ERROR: No emuMMC found on SD!")
        color(0xFFFFFF)
        println("Rebooting to Hekate in 5 seconds...")
        sleep(5000)
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (nandType == "sys") {
        println("NAND Target: sysMMC SYSTEM")
        targetName = "sysMMC SYSTEM"
        rc = mountsys("SYSTEM")
    } .else() {
        color(0xFF0000)
        println("ERROR: Invalid NAND flag: ", nandType)
        color(0xFFFFFF)
        println("Rebooting to Hekate in 5 seconds...")
        sleep(5000)
        goHekate()
        exit()
    }
}

if (rc) {
    color(0xFF0000)
    println("ERROR: SYSTEM partition mount failed rc: ", rc)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

# 2. Require and validate exact pack path (direct child of /config/kefir/nand_transfer)
if (!fsexists(packf)) {
    color(0xFF0000)
    println("ERROR: Missing pack path file: ", packf)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

raw = readfile(packf)
rel = raw.bytestostr()

if (rel.len() == 0) {
    color(0xFF0000)
    println("ERROR: Pack path file is empty!")
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

bks = rel.split("\\")
if (bks.len() != 1) {
    color(0xFF0000)
    println("ERROR: Pack path contains backslash: ", rel)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

parts = rel.split("/")
pLen = parts.len()
if (pLen != 5) {
    color(0xFF0000)
    println("ERROR: Malformed pack path structure: ", rel)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

p0 = parts[0]
p1 = parts[1]
p2 = parts[2]
p3 = parts[3]
p4 = parts[4]

badPackPath = 0
if (p0 != "") { badPackPath = 1 }
if (p1 != "config") { badPackPath = 1 }
if (p2 != "kefir") { badPackPath = 1 }
if (p3 != "nand_transfer") { badPackPath = 1 }
if (badPackPath) {
    color(0xFF0000)
    println("ERROR: Pack path outside /config/kefir/nand_transfer: ", rel)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

packNameShort = p4
badPackName = 0
if (packNameShort.len() == 0) { badPackName = 1 }
if (packNameShort == ".") { badPackName = 1 }
if (packNameShort == "..") { badPackName = 1 }
if (badPackName) {
    color(0xFF0000)
    println("ERROR: Invalid pack folder name: ", packNameShort)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

pack = "sd:" + rel

if (!fsexists(pack)) {
    color(0xFF0000)
    println("ERROR: Selected pack directory does not exist: ", pack)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

hasPackSave = fsexists(pack + "/8000000000000010")
if (!hasPackSave) {
    hasPackSave = fsexists(pack + "/80000000000000F0")
}
if (!hasPackSave) {
    color(0xFF0000)
    println("ERROR: Not a valid profiles & play hours pack: ", pack)
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

# 3. Play Hours Flag Check
do00F0 = 1
flagf = pending + "/restore_00F0"
if (fsexists(flagf)) {
    raw = readfile(flagf)
    flagText = raw.bytestostr()
    if (flagText == "0") {
        do00F0 = 0
        println("Play hours flag: skip 00F0")
    }
}

# 4. Enforce Mandatory Complete Safety Snapshot in /config/kefir/safety_backup
safetyDir = "sd:/config/kefir/safety_backup"
mkdir(safetyDir)

recordf = pending + "/safety_dir.txt"
if (fsexists(recordf)) {
    sDirRaw = readfile(recordf)
    sDirStr = sDirRaw.bytestostr()
    sParts = sDirStr.split(":")
    sPartsLen = sParts.len()
    sPart0 = ""
    if (sPartsLen > 0) {
        sPart0 = sParts[0]
    }
    hasSdPrefix = 0
    if (sPartsLen > 1) {
        if (sPart0 == "sd") { hasSdPrefix = 1 }
    }
    if (hasSdPrefix) {
        safetyDir = sDirStr
    } .else() {
        safetyDir = "sd:" + sDirStr
    }
} .else() {
    safetyDir = safetyDir + "/" + packNameShort
}
mkdir(safetyDir)

snap0010 = safetyDir + "/8000000000000010"
snap0011 = safetyDir + "/8000000000000011"
snap00F0 = safetyDir + "/80000000000000F0"
snapNand = safetyDir + "/nand"
snapPack = safetyDir + "/target_pack.txt"
snapOk = safetyDir + "/snapshot.ok"

needsSnap0010 = fsexists(pack + "/8000000000000010")
needsSnap0011 = 0
if (fsexists(pack + "/8000000000000011")) {
    if (fsexists("bis:/save/8000000000000011")) { needsSnap0011 = 1 }
}
needsSnap00F0 = 0
if (do00F0) {
    if (fsexists(pack + "/80000000000000F0")) {
        if (fsexists("bis:/save/80000000000000F0")) { needsSnap00F0 = 1 }
    }
}

# Check if existing verified snapshot belongs to THIS operation and NAND
canReuse = 0
hasSnapMeta = fsexists(snapOk)
if (hasSnapMeta) { hasSnapMeta = fsexists(snapNand) }
if (hasSnapMeta) { hasSnapMeta = fsexists(snapPack) }
if (hasSnapMeta) {
    sNandRaw = readfile(snapNand)
    sNand = sNandRaw.bytestostr()
    sPackRaw = readfile(snapPack)
    sPack = sPackRaw.bytestostr()
    sameOperation = 0
    if (sNand == nandType) {
        if (sPack == rel) { sameOperation = 1 }
    }
    if (sameOperation) {
        validSnaps = 1
        if (needsSnap0010) {
            if (!fsexists(snap0010)) { validSnaps = 0 }
        }
        if (needsSnap0011) {
            if (!fsexists(snap0011)) { validSnaps = 0 }
        }
        if (needsSnap00F0) {
            if (!fsexists(snap00F0)) { validSnaps = 0 }
        }
        if (validSnaps) {
            canReuse = 1
        }
    }
}

if (!canReuse) {
    delfile(snapOk)
    snapFail = 0
    if (needsSnap0010) {
        println("Creating safety snapshot: 8000000000000010...")
        delfile(snap0010)
        cRc = copyfile("bis:/save/8000000000000010", snap0010)
        if (cRc) { snapFail = 1 }
        if (!fsexists(snap0010)) { snapFail = 1 }
    }
    if (needsSnap0011) {
        println("Creating safety snapshot: 8000000000000011...")
        delfile(snap0011)
        cRc = copyfile("bis:/save/8000000000000011", snap0011)
        if (cRc) { snapFail = 1 }
        if (!fsexists(snap0011)) { snapFail = 1 }
    }
    if (needsSnap00F0) {
        println("Creating safety snapshot: 80000000000000F0...")
        delfile(snap00F0)
        cRc = copyfile("bis:/save/80000000000000F0", snap00F0)
        if (cRc) { snapFail = 1 }
        if (!fsexists(snap00F0)) { snapFail = 1 }
    }
    if (snapFail) {
        color(0xFF0000)
        println("ERROR: Safety snapshot failed! Restore aborted to protect NAND.")
        color(0xFFFFFF)
        println("Rebooting to Hekate in 5 seconds...")
        sleep(5000)
        goHekate()
        exit()
    }
    writefile(snapNand, readfile(nandf))
    writefile(snapPack, readfile(packf))
    writefile(snapOk, ["BYTE[]", 79, 75])
}

# Verify that all required snapshots are present and valid
allSnapsOk = 1
if (needsSnap0010) {
    if (!fsexists(snap0010)) { allSnapsOk = 0 }
}
if (needsSnap0011) {
    if (!fsexists(snap0011)) { allSnapsOk = 0 }
}
if (needsSnap00F0) {
    if (!fsexists(snap00F0)) { allSnapsOk = 0 }
}
if (!fsexists(snapOk)) {
    allSnapsOk = 0
}

if (!allSnapsOk) {
    color(0xFF0000)
    println("ERROR: Safety backup is incomplete or unverified!")
    println("Restore aborted to protect NAND.")
    color(0xFFFFFF)
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

# Mirror to pending for Undo compatibility
if (needsSnap0010) {
    if (fsexists(snap0010)) { copyfile(snap0010, pending + "/8000000000000010") }
}
if (needsSnap0011) {
    if (fsexists(snap0011)) { copyfile(snap0011, pending + "/8000000000000011") }
}
if (needsSnap00F0) {
    if (fsexists(snap00F0)) { copyfile(snap00F0, pending + "/80000000000000F0") }
}

hasSnap0010 = fsexists(snap0010)
hasSnap00F0 = fsexists(snap00F0)
hasRelevantSnap = 0
if (needsSnap0010) {
    if (hasSnap0010) { hasRelevantSnap = 1 }
}
if (needsSnap00F0) {
    if (hasSnap00F0) { hasRelevantSnap = 1 }
}

statBackup = "[VERIFIED]"
colBackup = 0x00FF00

wrote = 0
errors = 0
restoredSaves = 0
expectedSaves = 0

if (needsSnap0010) {
    expectedSaves = expectedSaves + 1
}
if (fsexists(pack + "/8000000000000011")) {
    expectedSaves = expectedSaves + 1
}
if (needsSnap00F0) {
    expectedSaves = expectedSaves + 1
}

curFileName = ""
curFileIdx = 0
curDirTotal = 0
curDir = ""
curSaveId = ""
curSaveShort = ""
stat0010 = "[PENDING]"
col0010 = 0x666666
stat0011 = "[PENDING]"
col0011 = 0x666666
stat00F0 = "[PENDING]"
col00F0 = 0x666666

clear()
drawDashboard()
logY = 14

msg = "  [i] Safety backup verified: " + safetyDir
colLog = 0x00FF00
logMsg()

# 1. Restore 0010 (Accounts/Profiles)
restoreSave0010()

# 2. Restore 0011 (User ID Generator)
restoreSave0011()

# 3. Restore 00F0 (Play Hours)
restoreSave00F0()

# Keep earlier error messages visible on the final screen.
println("Files written: ", wrote, " Errors: ", errors, " Saves committed: ", restoredSaves)

restoreOk = 0
if (errors == 0) {
    if (restoredSaves > 0) {
        if (restoredSaves == expectedSaves) { restoreOk = 1 }
    }
}
if (restoreOk) {
    writefile(pending + "/nand_restored.ok", ["BYTE[]", 79, 75])
    colLog = 0x00FF00
    msg = "=== RESTORE COMPLETED SUCCESSFULLY! ==="
    logMsg()
    msg = "User profiles, accounts, and play hours are now restored."
    logMsg()
} .else() {
    colLog = 0xFF0000
    msg = "=== WARNING: RESTORE COMPLETED WITH ERRORS! ==="
    logMsg()
    msg = "Check logs above. Failed saves were not committed."
    msg = "Safety backup retained: " + safetyDir
    logMsg()
    msg = "If console won't boot: run Undo_restore_if_wont_boot.te"
    logMsg()
}

colLog = 0xFFFFFF
msg = ""
logMsg()
msg = "Safety backup: " + safetyDir
logMsg()
colLog = 0x00FFFF
msg = "Rebooting to Hekate in 5 seconds..."
logMsg()

spinner(0)
sleep(5000)
goHekate()
