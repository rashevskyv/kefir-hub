# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# nand_transfer_restore_auto.te - Kefir Hub Profiles and Playtime Restore
# Safe flat known-tree traversal (no recursive variable collisions)
# Pre-checks fsexists before readfile (prevents fatal crashes)
# Automatically creates missing files via saveObj.create before write
# Single clean spinner at top-right (77, 0)
# Strictly formatted fixed-width activity lines preventing screen overflow
# Safety status reflects Hub Undo snapshot in restore_pending
# Skips 0041 cache; restores only 0010, 0011, and optional 00F0

goHekate = {
    println("Cleaning temp flags...")
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        delfile("sd:/bootloader/hekate_ipl.ini")
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    if (fsexists("sd:/bootloader/update.bin")) {
        println("Restoring Hekate (payload.bin)...")
        delfile("sd:/payload.bin")
        copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
    }
    println("Loading Hekate (bootloader/update.bin, payload.bin)...")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc) {
        if (fsexists("sd:/payload.bin")) {
            rc = payload("sd:/payload.bin")
        }
    }
    if (rc) {
        if (fsexists("sd:/bootloader/payloads/hekate.bin")) {
            rc = payload("sd:/bootloader/payloads/hekate.bin")
        }
    }
    if (rc) {
        if (fsexists("sd:/atmosphere/reboot_payload.bin")) {
            rc = payload("sd:/atmosphere/reboot_payload.bin")
        }
    }
    if (rc) {
        color(0xFF0000)
        println("Hekate payload not found (bootloader/update.bin, payload.bin).")
        color(0xFFFFFF)
        println("Press any button to reboot...")
        pause()
        reboot()
    }
}

# ------------------------------------------------------------------------------
# SPINNER AND DASHBOARD GUI
# ------------------------------------------------------------------------------

upd_s = {
    spinner()
}

drawDashboard = {
    pos = getprintpos()

    # Row 0: Clear top bar to eliminate white box glitch, draw title and single top-right hardware spinner
    setpixels(0, 0, 1280, 16, 0x1B1B1B)
    printpos(0, 0)
    color(0x00FFFF)
    print("=== Restore Profiles and Playtime v0.13.801 ===")
    spinner(1, 77, 0, 0x00FF00)

    # Row 1: Source Pack
    printpos(0, 1)
    color(0xFFFFFF)
    print("Source Pack:   ")
    color(0xFFFF00)
    print("sd:/config/kefir/nand_transfer/", packNameShort, "                  ")

    # Row 2: Target & Safety Backup
    printpos(0, 2)
    color(0xFFFFFF)
    print("Target: ")
    color(0x00FF00)
    print(targetName)
    color(0xFFFFFF)
    print("  |  Safety Backup: ")
    color(colBackup)
    print(statBackup, "                  ")

    # Row 3: Separator
    printpos(0, 3)
    color(0x666666)
    print("-----------------------------------------------------------------------------")

    # Row 4: Header
    printpos(0, 4)
    color(0x00FFFF)
    print("[TASK STATUS AND STATISTICS]")

    # Row 5: Safety Backup
    printpos(0, 5)
    color(0xFFFFFF)
    print("  Safety Backup:        ")
    color(colBackup)
    print(statBackup, "                           ")

    # Row 6: 0010
    printpos(0, 6)
    color(0xFFFFFF)
    print("  0010 (User Profiles): ")
    color(col0010)
    print(stat0010, "                           ")

    # Row 7: 0011
    printpos(0, 7)
    color(0xFFFFFF)
    print("  0011 (User ID Gen):   ")
    color(col0011)
    print(stat0011, "                           ")

    # Row 8: 00F0
    printpos(0, 8)
    color(0xFFFFFF)
    print("  00F0 (Play Hours):    ")
    color(col00F0)
    print(stat00F0, "                           ")

    # Row 9: Total progress
    printpos(0, 9)
    color(0xFFFFFF)
    print("  Total Progress:       ")
    color(0x00FF00)
    print(wrote, " files written")
    color(0xFFFFFF)
    print("  |  Errors: ")
    if (errors == 0) {
        color(0x00FF00)
    } .else() {
        color(0xFF0000)
    }
    print(errors, " errors        ")

    # Row 10: Separator
    printpos(0, 10)
    color(0x666666)
    print("-----------------------------------------------------------------------------")

    # Row 11: Activity line
    printpos(0, 11)
    color(0xFFFF00)
    print("Activity: ")
    color(0xFFFFFF)
    print("Ready                                                               ")

    # Row 12 belongs to native diagnostic stages; preserve its last result.

    # Row 13: Event Log Separator
    printpos(0, 13)
    color(0x666666)
    print("--- Event Log ---------------------------------------------------------------")

    color(0xFFFFFF)
    printpos(pos.x, pos.y)
}

drawProgress = {
    upd_s()

    # Clear activity row; preserve native diagnostic row 12.
    printpos(0, 11)
    print("                                                                             ")

    # Truncate filename if long (> 25 characters) to prevent line wrap
    fnameDisplay = curFileName
    if (curFileName.len() > 25) {
        cutLen = curFileName.len() - 22
        fnameDisplay = (curFileName - cutLen) + "..."
    }

    printpos(0, 11)
    color(0xFFFF00)
    print("Activity: ")
    color(0xFFFFFF)
    print(curSaveShort, " (", curFileIdx, "/", curDirTotal, "): ", curDir, "/", fnameDisplay, "                  ")

    # Live count update on row 9
    printpos(24, 9)
    color(0x00FF00)
    print(wrote, " files written")
    color(0xFFFFFF)
    print("  |  Errors: ")
    if (errors == 0) {
        color(0x00FF00)
    } .else() {
        color(0xFF0000)
    }
    print(errors, " errors        ")
    color(0xFFFFFF)
}

logMsg = {
    if (logY > 38) {
        logY = 14
    }
    printpos(0, logY)
    print("                                                                             ")
    printpos(0, logY)
    color(colLog)
    print(msg)
    color(0xFFFFFF)
    logY = logY + 1
}

# ------------------------------------------------------------------------------
# RESTORE IMPLEMENTATION (FROM KEFIRHUB NAND_TRANSFER PACK)
# ------------------------------------------------------------------------------

restoreFilesInDir = {
    dSrc = packSaveDir + curDir
    if (curDir == "/") {
        dSrc = packSaveDir
    }

    if (fsexists(dSrc)) {
        dList = readdir(dSrc)
        if (dList.result) {
            msg = "  [FAIL] readdir failed: " + curDir + " rc=" + dList.result.str()
            colLog = 0xFF0000
            logMsg()
            errors = errors + 1
            saveErrors = saveErrors + 1
        } .else() {
            dFiles = dList.files.copy()
            dTotal = dFiles.len()
            dIdx = 0
            if (dTotal) {
                dFiles.foreach("dName") {
                    dIdx = dIdx + 1
                    fsrc = dSrc + "/" + dName
                    if (curDir == "/") {
                        fdst = "/" + dName
                    } .else() {
                        fdst = curDir + "/" + dName
                    }

                    curFileName = dName
                    curFileIdx = dIdx
                    curDirTotal = dTotal
                    drawProgress()

                    if (!fsexists(fsrc)) {
                        msg = "  [SKIP] Missing: " + fsrc
                        colLog = 0xFFFF00
                        logMsg()
                        errors = errors + 1
                        saveErrors = saveErrors + 1
                    } .else() {
                        innerPath = fdst
                        sdPath = fsrc
                        upd_s()
                        rc = saveObj.writeFromFile(innerPath, sdPath)
                        upd_s()
                        if (rc) {
                            msg = "  [FAIL] Write failed: " + fdst + " rc=" + rc.str()
                            colLog = 0xFF0000
                            logMsg()
                            errors = errors + 1
                            saveErrors = saveErrors + 1
                        } .else() {
                            wrote = wrote + 1
                            saveFilesDone = saveFilesDone + 1
                        }
                    }
                }
            }
        }
    }
}

restoreSave0010 = {
    curSaveId = "8000000000000010"
    curSaveShort = "0010"
    packSaveDir = pack + "/" + curSaveId
    bis = "bis:/save/" + curSaveId

    if (!fsexists(packSaveDir)) {
        stat0010 = "[SKIPPED] (Not in pack)"
        col0010 = 0x666666
        drawDashboard()
    } .else() {
        if (!fsexists(bis)) {
            stat0010 = "[FAIL] (Target save missing)"
            col0010 = 0xFF0000
            drawDashboard()
            errors = errors + 1
        } .else() {
            clear()
            stat0010 = "[IN PROGRESS]"
            col0010 = 0xFFFF00
            drawDashboard()
            logY = 14

            msg = "  [*] Opening save 8000000000000010 (User Profiles)..."
            colLog = 0x00FFFF
            logMsg()
            upd_s()

            saveObj = readsave(bis)
            saveFilesDone = 0
            saveErrors = 0

            curDir = "/"
            restoreFilesInDir()
            curDir = "/su"
            restoreFilesInDir()
            curDir = "/su/baas"
            restoreFilesInDir()
            curDir = "/su/nas"
            restoreFilesInDir()
            curDir = "/su/avators"
            restoreFilesInDir()
            curDir = "/su/cache"
            restoreFilesInDir()

            if (saveErrors == 0) {
                msg = "  [*] Committing 8000000000000010..."
                colLog = 0xFFFF00
                logMsg()
                upd_s()
                commitRc = saveObj.commit()
                if (commitRc) {
                    errors = errors + 1
                    saveErrors = saveErrors + 1
                    stat0010 = "[FAILED] (Commit rc=" + commitRc.str() + ")"
                    col0010 = 0xFF0000
                    msg = "  [FAIL] Commit failed: 8000000000000010 rc=" + commitRc.str()
                    colLog = 0xFF0000
                    logMsg()
                    saveObj.close()
                    saveObj = 0
                } .else() {
                    upd_s()
                    saveObj.close()
                    saveObj = 0
                    msg = "  [*] Verifying 8000000000000010 streaming readback..."
                    colLog = 0xFFFF00
                    logMsg()
                    upd_s()
                    verifyObj = readsave(bis)
                    if (!verifyObj) {
                        errors = errors + 1
                        saveErrors = saveErrors + 1
                        stat0010 = "[FAILED] (Readback reopen failed)"
                        col0010 = 0xFF0000
                        msg = "  [FAIL] Could not reopen 8000000000000010 for readback"
                        colLog = 0xFF0000
                        logMsg()
                    } .else() {
                        readbackFail = 0
                        chkInner = "/su/registry.dat"
                        chkSd = packSaveDir + chkInner
                        if (fsexists(chkSd)) {
                            cmpRc = verifyObj.compareToFile(chkInner, chkSd)
                            if (cmpRc) {
                                readbackFail = 1
                            }
                        }
                        verifyObj.close()
                        verifyObj = 0
                        if (readbackFail) {
                            errors = errors + 1
                            saveErrors = saveErrors + 1
                            stat0010 = "[FAILED] (Readback mismatch)"
                            col0010 = 0xFF0000
                            msg = "  [FAIL] Streaming readback mismatch in 8000000000000010"
                            colLog = 0xFF0000
                            logMsg()
                        } .else() {
                            stat0010 = "[RESTORED] (" + saveFilesDone.str() + " files)"
                            col0010 = 0x00FF00
                            restoredSaves = restoredSaves + 1
                            msg = "  [OK] Profiles save committed and verified successfully!"
                            colLog = 0x00FF00
                            logMsg()
                        }
                    }
                }
            } .else() {
                saveObj.close()
                saveObj = 0
                stat0010 = "[FAILED] (" + saveErrors.str() + " errors)"
                col0010 = 0xFF0000
                msg = "  [FAIL] Errors during restore, commit skipped!"
                colLog = 0xFF0000
                logMsg()
            }
            drawDashboard()
        }
    }
}

