# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# If Restore Backup left the console unable to boot, run this from
# TegraExplorer Scripts. Puts the raw 0010 snapshot back on the same NAND
# it was taken from (flag file restore_pending/nand = emu|sys).

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    println("Cleaning temp files...")
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        delfile("sd:/bootloader/hekate_ipl.ini")
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    println("Loading Hekate (bootloader/update.bin)...")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc) {
        color(0xFF0000)
        println("Hekate payload not found (bootloader/update.bin).")
        color(0xFFFFFF)
        println("Press any button to reboot...")
        pause()
        reboot()
    }
}

clear()
println("Kefir Hub: undo Restore Backup")
println("Puts the raw account save back if the console will not boot.")
println("")

pending = "sd:/config/kefir/restore_pending"
snap = combinepath(pending, "8000000000000010")
snapF0 = combinepath(pending, "80000000000000F0")
nandf = combinepath(pending, "nand")
bis = "bis:/save/8000000000000010"
bisF0 = "bis:/save/80000000000000F0"

if (!fsexists(snap) && !fsexists(snapF0)) {
    println("No raw 0010/00F0 snapshot on SD.")
    println(snap)
    goHekate()
    exit()
}
if (!fsexists(nandf)) {
    println("No NAND flag (emu/sys) next to the snapshot.")
    println(nandf)
    goHekate()
    exit()
}

raw = readfile(nandf)
text = raw.bytestostr()
if (text == "emu") {
    println("NAND flag: emuMMC SYSTEM")
    if (!emu()) {
        println("No emuMMC")
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (text != "sys") {
        println("Bad NAND flag", text)
        goHekate()
        exit()
    }
    println("NAND flag: sysMMC SYSTEM")
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

if (fsexists(snap)) {
    if (fsexists(bis)) {
        delfile(bis)
    }
    println("Restoring raw", snap)
    rc = copyfile(snap, bis)
    if (rc) {
        println("copyfile 0010 failed", rc)
        goHekate()
        exit()
    }
    if (!fsexists(bis)) {
        println("BIS 0010 missing after copy")
        goHekate()
        exit()
    }
} .else() {
    println("No raw 0010 snapshot; skipping profiles undo")
}

if (fsexists(snapF0)) {
    if (fsexists(bisF0)) {
        delfile(bisF0)
    }
    println("Restoring raw", snapF0)
    rc = copyfile(snapF0, bisF0)
    if (rc) {
        println("copyfile 00F0 failed", rc)
        goHekate()
        exit()
    }
    if (!fsexists(bisF0)) {
        println("BIS 00F0 missing after copy")
        goHekate()
        exit()
    }
} .else() {
    println("No raw 00F0 snapshot; skipping play-hours undo")
}

writefile(combinepath(pending, "rolled_back.ok"), ["BYTE[]", 79, 75])
delfile(combinepath(pending, "state.json"))

println("Removing this script")
delfile("sd:/TegraExplorer/scripts/Undo_restore_if_wont_boot.te")
delfile("sd:/TegraExplorer/scripts/account_0010_rollback.te")
delfile("sd:/TegraExplorer/scripts/account_0010_dump.te")
delfile("sd:/TegraExplorer/scripts/account_0010_apply_link.te")
delfile("sd:/TegraExplorer/scripts/nand_transfer_restore_auto.te")

println("")
println("Raw system save snapshot(s) restored.")
println("Press any button to reboot to Hekate...")
pause()
goHekate()
