# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# If Restore Backup left the console unable to boot, run this from
# TegraExplorer Scripts. Puts the raw 0010 snapshot back on the same NAND
# it was taken from (flag file restore_pending/nand = emu|sys).

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    println("Cleaning temp files...")
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        delfile("sd:/bootloader/hekate_ipl.ini")
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/config/kefir/hekate-payload-request.ini")
    if (fsexists("sd:/bootloader/update.bin")) {
        println("Restoring Hekate (payload.bin)...")
        delfile("sd:/payload.bin")
        copyfile("sd:/bootloader/update.bin", "sd:/payload.bin")
    }
    println("Loading Hekate (bootloader/update.bin, payload.bin)...")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc) {
        if (fsexists("sd:/payload.bin")) { rc = payload("sd:/payload.bin") }
    }
    if (rc) {
        if (fsexists("sd:/bootloader/payloads/hekate.bin")) { rc = payload("sd:/bootloader/payloads/hekate.bin") }
    }
    if (rc) {
        if (fsexists("sd:/atmosphere/reboot_payload.bin")) { rc = payload("sd:/atmosphere/reboot_payload.bin") }
    }
    if (rc) {
        color(0xFF0000)
        println("Hekate payload not found (bootloader/update.bin, payload.bin).")
        color(0xFFFFFF)
        println("Press any button to reboot...")
        pause()
        reboot()
    }
}

clear()
println("Kefir Hub v0.13.801: undo Restore Backup")
println("Puts the raw system save snapshot(s) back if the console will not boot.")
println("")

pending = "sd:/config/kefir/restore_pending"
recordf = combinepath(pending, "safety_dir.txt")

if (!fsexists(recordf)) {
    color(0xFF0000)
    println("ERROR: Missing recorded safety_dir.txt in restore_pending!")
    println("Cannot safely locate snapshot for this restore operation.")
    color(0xFFFFFF)
    println("Undo aborted to avoid restoring unrelated backups.")
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

sDirRaw = readfile(recordf)
sDirStr = sDirRaw.bytestostr()
sParts = sDirStr.split(":")
sPartsLen = sParts.len()
sPart0 = ""
if (sPartsLen > 0) {
    sPart0 = sParts[0]
}
hasSdPrefix = 0
if (sPartsLen > 1) {
    if (sPart0 == "sd") { hasSdPrefix = 1 }
}
if (hasSdPrefix) {
    safety = sDirStr
} .else() {
    safety = "sd:" + sDirStr
}

snapOk = combinepath(safety, "snapshot.ok")
badSafety = !fsexists(safety)
if (!fsexists(snapOk)) { badSafety = 1 }
if (badSafety) {
    color(0xFF0000)
    println("ERROR: Recorded safety backup missing or unverified:")
    println(safety)
    color(0xFFFFFF)
    println("Undo aborted to avoid restoring invalid or unrelated backups.")
    println("Rebooting to Hekate in 5 seconds...")
    sleep(5000)
    goHekate()
    exit()
}

snap = combinepath(safety, "8000000000000010")
snap11 = combinepath(safety, "8000000000000011")
snapF0 = combinepath(safety, "80000000000000F0")
nandf = combinepath(safety, "nand")

bis = "bis:/save/8000000000000010"
bis11 = "bis:/save/8000000000000011"
bisF0 = "bis:/save/80000000000000F0"

hasAnySnap = fsexists(snap)
if (!hasAnySnap) { hasAnySnap = fsexists(snapF0) }
if (!hasAnySnap) { hasAnySnap = fsexists(snap11) }
if (!hasAnySnap) {
    println("No raw 0010/0011/00F0 snapshot on SD.")
    println(snap)
    goHekate()
    exit()
}
if (!fsexists(nandf)) {
    println("No NAND flag (emu/sys) next to the snapshot.")
    println(nandf)
    goHekate()
    exit()
}

raw = readfile(nandf)
text = raw.bytestostr()
if (text == "emu") {
    println("NAND flag: emuMMC SYSTEM")
    if (!emu()) {
        println("No emuMMC")
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (text != "sys") {
        println("Bad NAND flag", text)
        goHekate()
        exit()
    }
    println("NAND flag: sysMMC SYSTEM")
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

if (fsexists(snap)) {
    if (fsexists(bis)) {
        delfile(bis)
    }
    println("Restoring raw", snap)
    rc = copyfile(snap, bis)
    if (rc) {
        println("copyfile 0010 failed", rc)
        goHekate()
        exit()
    }
    if (!fsexists(bis)) {
        println("BIS 0010 missing after copy")
        goHekate()
        exit()
    }
} .else() {
    println("No raw 0010 snapshot; skipping profiles undo")
}

if (fsexists(snap11)) {
    if (fsexists(bis11)) {
        delfile(bis11)
    }
    println("Restoring raw", snap11)
    rc = copyfile(snap11, bis11)
    if (rc) {
        println("copyfile 0011 failed", rc)
        goHekate()
        exit()
    }
    if (!fsexists(bis11)) {
        println("BIS 0011 missing after copy")
        goHekate()
        exit()
    }
} .else() {
    println("No raw 0011 snapshot; skipping UID generator undo")
}

if (fsexists(snapF0)) {
    if (fsexists(bisF0)) {
        delfile(bisF0)
    }
    println("Restoring raw", snapF0)
    rc = copyfile(snapF0, bisF0)
    if (rc) {
        println("copyfile 00F0 failed", rc)
        goHekate()
        exit()
    }
    if (!fsexists(bisF0)) {
        println("BIS 00F0 missing after copy")
        goHekate()
        exit()
    }
} .else() {
    println("No raw 00F0 snapshot; skipping play-hours undo")
}

if (fsexists(pending)) {
    writefile(combinepath(pending, "rolled_back.ok"), ["BYTE[]", 79, 75])
    delfile(combinepath(pending, "state.json"))
}

println("Removing this script")
delfile("sd:/TegraExplorer/scripts/Undo_restore_if_wont_boot.te")
delfile("sd:/TegraExplorer/scripts/account_0010_rollback.te")
delfile("sd:/TegraExplorer/scripts/account_0010_dump.te")
delfile("sd:/TegraExplorer/scripts/account_0010_apply_link.te")
delfile("sd:/TegraExplorer/scripts/nand_transfer_restore_auto.te")

println("")
println("Raw system save snapshot(s) restored.")
println("Safety backup remains on SD: ", safety)
println("Press any button to reboot to Hekate...")
pause()
goHekate()
