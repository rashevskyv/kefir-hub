# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# If Restore Backup left the console unable to boot, run this from
# TegraExplorer Scripts. Puts the old profiles back and cancels restore.

writeDir = {
    src = srcRoot
    if (rel.len()) {
        src = combinepath(srcRoot, rel)
    }
    listing = readdir(src)
    if (listing.result) {
        println("readdir fail", src)
        errors = errors + 1
    } .else() {
        files = listing.files.copy()
        subs = listing.folders.copy()
        files.foreach("fname") {
            fsrc = combinepath(src, fname)
            fdst = "/" + fname
            if (rel.len()) {
                fdst = "/" + rel + "/" + fname
            }
            println(fdst)
            bytes = readfile(fsrc)
            rc = saveObj.write(fdst, bytes)
            if (rc) {
                println("write fail", fdst, rc)
                errors = errors + 1
            } .else() {
                wrote = wrote + 1
            }
        }
        subs.foreach("dname") {
            oldrel = rel
            if (rel.len()) {
                rel = rel + "/" + dname
            } .else() {
                rel = dname
            }
            writeDir()
            rel = oldrel
        }
    }
}

goHekate = {
    saveObj = dict()
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc) {
        println("Could not load hekate", rc)
        pause()
    }
}

clear()
println("Kefir Hub: undo Restore Backup")
println("Puts old profiles back if the console will not boot.")
println("")

srcRoot = "sd:/config/kefir/restore_pending/0010"
if (!fsexists(srcRoot)) {
    println("No profile snapshot on SD.")
    println(srcRoot)
    goHekate()
    exit()
}

targets = ["Cancel"].copy()
targets.add("emuMMC SYSTEM")
targets.add("sysMMC SYSTEM")
choice = menu(targets, 0)
if (!choice) {
    goHekate()
    exit()
}
if (choice == 1) {
    if (!emu()) {
        println("No emuMMC")
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    goHekate()
    exit()
}

bis = "bis:/save/8000000000000010"
if (!fsexists(bis)) {
    println("No account save on this SYSTEM")
    goHekate()
    exit()
}

println("Writing old profiles back")
saveObj = readsave(bis)
wipeSaveFolder = {
    listing = saveObj.readdir(saveRel)
    if (!listing.result) {
        files = listing.files.copy()
        files.foreach("fname") {
            fpath = saveRel + "/" + fname
            println("delete", fpath)
            saveObj.delete(fpath)
        }
    }
}
saveRel = "/su/baas"
wipeSaveFolder()
saveRel = "/su/nas"
wipeSaveFolder()
saveRel = "/baas"
wipeSaveFolder()
saveRel = "/nas"
wipeSaveFolder()
rel = ""
wrote = 0
errors = 0
writeDir()
println("commit")
saveObj.commit()

pending = "sd:/config/kefir/restore_pending"
writefile(combinepath(pending, "rolled_back.ok"), ["BYTE[]", 79, 75])
delfile(combinepath(pending, "state.json"))

println("Removing this script")
delfile("sd:/TegraExplorer/scripts/Undo_restore_if_wont_boot.te")
delfile("sd:/TegraExplorer/scripts/account_0010_rollback.te")
delfile("sd:/TegraExplorer/scripts/account_0010_dump.te")

println("")
println("wrote", wrote, "errors", errors)
println("Loading hekate. Hub will not continue the restore.")
goHekate()
