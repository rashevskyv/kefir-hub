# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# One-shot: Hub writes restore_pending/nand + nand_pack.txt, copies this to
# sd:/startup.te. Known-tree dump of 0010/0011/00F0/0041 (test.te style:
# readdir("/su/baas"), read("/su/"+name), writefile("sd:/...", bytes)).
# TE 4.2.0 does not scroll: clear() each save and before RESULT.
# Missing optional dirs are skip, not error. Then pause, then hekate.

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    lines = []
    bytes = ["BYTE[]"]
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc) {
        reboot()
    }
}

dumpFilesIn = {
    println("dir", savePath)
    listing = saveObj.readdir(savePath)
    if (listing.result) {
        println("skip", savePath)
    } .else() {
        if (savePath != "/") {
            mkdir(dstRoot + savePath)
        }
        files = listing.files.copy()
        println(" files", files.len())
        files.foreach("fname") {
            fsrc = savePath + "/" + fname
            if (savePath == "/") {
                fsrc = "/" + fname
            }
            println(fsrc)
            bytes = saveObj.read(fsrc)
            out = dstRoot + fsrc
            writefile(out, bytes)
            wrote = wrote + 1
        }
    }
}

dumpKnownTree = {
    mkdir(dstRoot)
    savePath = "/"
    dumpFilesIn()
    savePath = "/su"
    dumpFilesIn()
    savePath = "/su/baas"
    dumpFilesIn()
    savePath = "/su/nas"
    dumpFilesIn()
    savePath = "/su/avators"
    dumpFilesIn()
    savePath = "/su/cache"
    dumpFilesIn()
}

dumpOne = {
    clear()
    println("Kefir Hub: dump profiles & play hours")
    println("save", saveId)
    println("pack:", pack)
    println("")
    bis = "bis:/save/" + saveId
    if (!fsexists(bis)) {
        println("skip missing", bis)
    } .else() {
        println("open", bis)
        saveObj = readsave(bis)
        dstRoot = pack + "/" + saveId
        mkdir(dstRoot)
        wrote_before = wrote
        if (saveId == "80000000000000F0") {
            savePath = "/"
            dumpFilesIn()
            println("PlayEvent.dat")
            bytes = saveObj.read("PlayEvent.dat")
            writefile(dstRoot + "/PlayEvent.dat", bytes)
            wrote = wrote + 1
        } .else() {
            dumpKnownTree()
        }
        if (wrote > wrote_before) {
            dumped = dumped + 1
            if (saveId == "8000000000000010") {
                got0010 = 1
            }
            if (saveId == "80000000000000F0") {
                got00F0 = 1
            }
            println("ok", saveId, "files", wrote - wrote_before)
        } .else() {
            println("empty", saveId)
        }
    }
}

clear()
println("Kefir Hub: dump profiles & play hours")
println("Decrypts SYSTEM saves with this console keys.")
println("")

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

pending = "sd:/config/kefir/restore_pending"
nandf = pending + "/nand"
packf = pending + "/nand_pack.txt"
delfile(pending + "/dump_result.txt")

if (!fsexists(nandf)) {
    println("No NAND flag (emu/sys)")
    println("Open Kefir Hub to continue.")
    pause()
    goHekate()
    exit()
}
if (!fsexists(packf)) {
    println("No pack path file")
    println("Open Kefir Hub to continue.")
    pause()
    goHekate()
    exit()
}

raw = readfile(nandf)
text = raw.bytestostr()
if (text == "emu") {
    println("NAND flag: emuMMC SYSTEM")
    if (!emu()) {
        println("No emuMMC")
        println("Open Kefir Hub to continue.")
        pause()
        goHekate()
        exit()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (text != "sys") {
        println("Bad NAND flag", text)
        println("Open Kefir Hub to continue.")
        pause()
        goHekate()
        exit()
    }
    println("NAND flag: sysMMC SYSTEM")
    rc = mountsys("SYSTEM")
}
if (rc) {
    println("SYSTEM mount failed", rc)
    println("Open Kefir Hub to continue.")
    pause()
    goHekate()
    exit()
}

raw = readfile(packf)
packUnix = raw.bytestostr()
pack = "sd:" + packUnix
println("pack:", pack)
mkdir(pack)
delfile(pack + "/dump_result.txt")

wrote = 0
dumped = 0
got0010 = 0
got00F0 = 0
ids = ["8000000000000010", "8000000000000011", "80000000000000F0", "8000000000000041"]
ids.foreach("saveId") {
    dumpOne()
}

clear()
println("Kefir Hub: dump profiles & play hours")
println("RESULT")
println("wrote", wrote)
println("saves", dumped)
println("got0010", got0010)
println("got00F0", got00F0)
if (!got0010) {
    println("INCOMPLETE: no profiles (0010)")
    println("Open Kefir Hub to retry.")
    pause()
    goHekate()
    exit()
}
if (!got00F0) {
    println("INCOMPLETE: no play hours (00F0)")
    println("Open Kefir Hub to retry.")
    pause()
    goHekate()
    exit()
}

writefile(pending + "/dumped.ok", ["BYTE[]", 79, 75])
println("OK  profiles and play hours dumped.")
println("Open Kefir Hub to confirm.")
pause()
goHekate()