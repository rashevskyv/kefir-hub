# REQUIRE SD
# REQUIRE KEYS
# REQUIRE MINERVA
# REQUIRE VER 4.0.0

# One-shot: Hub writes restore_pending/nand + nand_pack.txt, copies this to
# sd:/startup.te. Known-tree dump. TE 4.2.0 does not scroll: clear() each
# save and before RESULT. RESULT uses color(): green OK / red NOT OK.

goHekate = {
    saveObj = dict()
    raw = ["BYTE[]"]
    text = ""
    lines = []
    bytes = ["BYTE[]"]
    println("Cleaning temp files")
    delfile("sd:/startup.te")
    if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
        copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
        delfile("sd:/bootloader/hekate_ipl.ini.bak")
    }
    delfile("sd:/TegraExplorer/scripts/nand_transfer_dump_auto.te")
    delfile("sd:/config/kefir/restore_pending/nand_transfer_dump_auto.te")
    delfile("sd:/config/kefir/restore_pending/dump_result.txt")
    if (pack.len()) {
        delfile(pack + "/dump_result.txt")
    }
    println("Loading hekate")
    rc = 1
    if (fsexists("sd:/bootloader/update.bin")) {
        rc = payload("sd:/bootloader/update.bin")
    }
    if (rc && fsexists("sd:/payload.bin")) {
        rc = payload("sd:/payload.bin")
    }
    if (rc && fsexists("sd:/atmosphere/reboot_payload.bin")) {
        rc = payload("sd:/atmosphere/reboot_payload.bin")
    }
    if (rc && fsexists("sd:/bootloader/payloads/hekate.bin")) {
        rc = payload("sd:/bootloader/payloads/hekate.bin")
    }
    if (rc) {
        reboot()
    }
}
drawProgress = {
    printpos(0, statusY)
    print("                                                                             ")
    printpos(0, statusY)
    if (fname.len() < 50) {
        print(statusState, idx, "/", total, fname, "")
    } .else() {
        print(statusState, idx, "/", total, "")
    }
}

dumpFilesIn = {
    println("dir", savePath)
    listing = saveObj.readdir(savePath)
    if (listing.result) {
        println("skip", savePath)
    } .else() {
        if (savePath != "/") {
            mkdir(dstRoot + savePath)
        }
        files = listing.files.copy()
        idx = 0
        total = files.len()
        println(" files", total)
        if (total) {
            statusPos = getprintpos()
            statusY = statusPos.y
            files.foreach("fname") {
                fsrc = savePath + "/" + fname
                if (savePath == "/") {
                    fsrc = "/" + fname
                }
                idx = idx + 1
                if (fname == "player.vend.dat") {
                    statusState = "skip slow"
                    drawProgress()
                } .else() {
                    statusState = "copy"
                    drawProgress()
                    bytes = saveObj.read(fsrc)
                    out = dstRoot + fsrc
                    writefile(out, bytes)
                    wrote = wrote + 1
                }
            }
            printpos(0, statusY + 1)
        }
    }
}

dumpKnownTree = {
    mkdir(dstRoot)
    savePath = "/"
    dumpFilesIn()
    savePath = "/su"
    dumpFilesIn()
    savePath = "/su/baas"
    dumpFilesIn()
    savePath = "/su/nas"
    dumpFilesIn()
    savePath = "/su/avators"
    dumpFilesIn()
    savePath = "/su/cache"
    dumpFilesIn()
}

setSaveStat = {
    if (saveId == "8000000000000010") {
        n0010 = nthis
        s0010 = st
    }
    if (saveId == "8000000000000011") {
        n0011 = nthis
        s0011 = st
    }
    if (saveId == "80000000000000F0") {
        n00F0 = nthis
        s00F0 = st
    }
    if (saveId == "8000000000000041") {
        n0041 = nthis
        s0041 = st
    }
}

dumpOne = {
    clear()
    color(0xFFFFFF)
    println("Kefir Hub: dump profiles & play hours")
    println("save", saveId)
    println("pack:", pack)
    println("")
    nthis = 0
    st = 0
    bis = "bis:/save/" + saveId
    if (!fsexists(bis)) {
        println("skip missing", bis)
        st = 0
        nthis = 0
    } .else() {
        println("open", bis)
        saveObj = readsave(bis)
        dstRoot = pack + "/" + saveId
        mkdir(dstRoot)
        wrote_before = wrote
        if (saveId == "80000000000000F0") {
            savePath = "/"
            dumpFilesIn()
            if (wrote == wrote_before) {
                println("PlayEvent.dat")
                bytes = saveObj.read("PlayEvent.dat")
                writefile(dstRoot + "/PlayEvent.dat", bytes)
                wrote = wrote + 1
            }
        } .else() {
            dumpKnownTree()
        }
        nthis = wrote - wrote_before
        if (nthis > 0) {
            st = 1
            dumped = dumped + 1
            if (saveId == "8000000000000010") {
                got0010 = 1
            }
            if (saveId == "80000000000000F0") {
                got00F0 = 1
            }
            println("ok", saveId, "files", nthis)
        } .else() {
            st = 2
            println("empty", saveId)
        }
    }
    setSaveStat()
}

printSave = {
    color(0xFFFFFF)
    println(label)
    if (st == 1) {
        color(0x00FF00)
        println("  dumped ", nfiles, "files")
    } .else() {
        if (required) {
            color(0xFF0000)
            if (st == 2) {
                println("  empty")
            } .else() {
                println("  missing")
            }
        } .else() {
            color(0xFFFF00)
            if (st == 2) {
                println("  empty")
            } .else() {
                println("  skip")
            }
        }
    }
    color(0xFFFFFF)
}

printResult = {
    clear()
    color(0xFFFFFF)
    println("Kefir Hub: dump profiles & play hours")
    println("RESULT")
    println("")
    println("NAND:", nandName)
    println("pack:", pack)
    println("")
    label = "Profiles (0010)"
    st = s0010
    nfiles = n0010
    required = 1
    printSave()
    label = "User ID generator (0011)"
    st = s0011
    nfiles = n0011
    required = 0
    printSave()
    label = "Play hours (00F0)"
    st = s00F0
    nfiles = n00F0
    required = 1
    printSave()
    label = "HOME icons (0041)"
    st = s0041
    nfiles = n0041
    required = 0
    printSave()
    println("")
    if (got0010) {
        if (got00F0) {
            color(0x00FF00)
            println("OK")
            color(0xFFFFFF)
            println("Profiles and play hours dumped.")
            println("Open Kefir Hub to confirm.")
            writefile(pending + "/dumped.ok", ["BYTE[]", 79, 75])
        } .else() {
            color(0xFF0000)
            println("NOT OK")
            color(0xFFFFFF)
            println("Play hours (00F0) not dumped.")
            println("Open Kefir Hub to retry.")
        }
    } .else() {
        color(0xFF0000)
        println("NOT OK")
        color(0xFFFFFF)
        println("Profiles (0010) not dumped.")
        println("Open Kefir Hub to retry.")
    }
    color(0xFFFFFF)
}

failOut = {
    color(0xFF0000)
    println("NOT OK")
    color(0xFFFFFF)
    println(failMsg)
    println("Open Kefir Hub to continue.")
    goHekate()
    exit()
}

clear()
color(0xFFFFFF)
println("Kefir Hub: dump profiles & play hours")
println("Decrypts SYSTEM saves with this console keys.")
println("")

pack = ""
pending = "sd:/config/kefir/restore_pending"

delfile("sd:/startup.te")
if (fsexists("sd:/bootloader/hekate_ipl.ini.bak")) {
    copyfile("sd:/bootloader/hekate_ipl.ini.bak", "sd:/bootloader/hekate_ipl.ini")
}

nandf = pending + "/nand"
packf = pending + "/nand_pack.txt"
delfile(pending + "/dump_result.txt")

nandName = ""
if (!fsexists(nandf)) {
    failMsg = "No NAND flag (emu/sys)"
    failOut()
}
if (!fsexists(packf)) {
    failMsg = "No pack path file"
    failOut()
}

raw = readfile(nandf)
text = raw.bytestostr()
if (text == "emu") {
    nandName = "emuMMC SYSTEM"
    println("NAND flag: emuMMC SYSTEM")
    if (!emu()) {
        failMsg = "No emuMMC"
        failOut()
    }
    rc = mountemu("SYSTEM")
} .else() {
    if (text != "sys") {
        failMsg = "Bad NAND flag"
        failOut()
    }
    nandName = "sysMMC SYSTEM"
    println("NAND flag: sysMMC SYSTEM")
    rc = mountsys("SYSTEM")
}
if (rc) {
    failMsg = "SYSTEM mount failed"
    failOut()
}

raw = readfile(packf)
packUnix = raw.bytestostr()
pack = "sd:" + packUnix
println("pack:", pack)
mkdir(pack)
delfile(pack + "/dump_result.txt")

wrote = 0
dumped = 0
got0010 = 0
got00F0 = 0
n0010 = 0
n0011 = 0
n00F0 = 0
n0041 = 0
s0010 = 0
s0011 = 0
s00F0 = 0
s0041 = 0
ids = ["8000000000000010", "8000000000000011", "80000000000000F0", "8000000000000041"]
ids.foreach("saveId") {
    dumpOne()
}

printResult()
goHekate()
