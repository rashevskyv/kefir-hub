    set(haze_cpp_prev "void Exit() {\n    std::scoped_lock lock{g_mutex};\n    if (!g_haze) {\n        return;\n    }\n\n    /* this will block until thread exit. */\n    g_haze.reset();\n}\n\nvoid CancelTransfer() {\n    std::scoped_lock lock{g_mutex};\n    if (g_haze) {\n        g_haze->CancelTransfer();\n    }\n}\n\nvoid ClearTransferCancel() {\n    std::scoped_lock lock{g_mutex};\n    if (g_haze) {\n        g_haze->ClearTransferCancel();\n    }\n}\n\n} // namespace haze")
    set(haze_cpp_target "void Exit() {\n    std::unique_ptr<haze::ConsoleMainLoop> haze_to_destroy;\n    {\n        std::scoped_lock lock{g_mutex};\n        if (!g_haze) {\n            return;\n        }\n\n        /* move instance so g_mutex is released before blocking on thread exit. */\n        haze_to_destroy = std::move(g_haze);\n    }\n}\n\nvoid CancelTransfer() {\n    std::scoped_lock lock{g_mutex};\n    if (g_haze) {\n        g_haze->CancelTransfer();\n    }\n}\n\n} // namespace haze")
