if(EXISTS "source/usb_session.cpp")
    file(READ "source/usb_session.cpp" src)

    set(single_ce "    Result UsbSession::CancelEndpoint(UsbSessionEndpoint ep, u32 urb_id) {\n        R_UNLESS(m_endpoints[ep], haze::ResultInvalidArgument());\n\n        /* Request hardware cancellation of in-flight URBs on endpoint. */\n        R_TRY(usbDsEndpoint_Cancel(m_endpoints[ep]));\n\n        /* Wait for driver to signal completion event after cancel (bounded to 1s). */\n        R_TRY(eventWait(std::addressof(m_endpoints[ep]->CompletionEvent), 1000000000ULL));\n\n        /* Harvest report to ensure URB retirement and clear endpoint completion state. */\n        u32 transferred = 0;\n        const Result res = this->GetTransferResult(ep, urb_id, std::addressof(transferred));\n        if (res == haze::ResultCancelled() || R_SUCCEEDED(res)) {\n            R_SUCCEED();\n        }\n\n        R_RETURN(res);\n    }")
    set(dup_ce "${single_ce}\n\n${single_ce}")
    string(FIND "${src}" "${dup_ce}" find_dup_ce)
    if(NOT find_dup_ce EQUAL -1)
        string(REPLACE "${dup_ce}" "${single_ce}" src "${src}")
        file(WRITE "source/usb_session.cpp" "${src}")
    endif()

    string(FIND "${src}" "parse_res == 0x748C" find_urb_cancel)
    string(FIND "${src}" "res == haze::ResultCancelled() || R_SUCCEEDED(res)" find_ce_verified)
    string(FIND "${src}" "${dup_ce}" find_dup_after_clean)
    if(NOT find_urb_cancel EQUAL -1 AND NOT find_ce_verified EQUAL -1 AND find_dup_after_clean EQUAL -1)
        message(STATUS "[libhaze-patch] usb_session.cpp cancel already patched")
    else()
        set(usb_sess_old "    Result UsbSession::GetTransferResult(UsbSessionEndpoint ep, u32 urb_id, u32 *out_transferred_size) {\n        UsbDsReportData report_data;\n\n        R_TRY(eventClear(std::addressof(m_endpoints[ep]->CompletionEvent)));\n        R_TRY(usbDsEndpoint_GetReportData(m_endpoints[ep], std::addressof(report_data)));\n        R_TRY(usbDsParseReportData(std::addressof(report_data), urb_id, nullptr, out_transferred_size));\n\n        R_SUCCEED();\n    }")
        set(usb_sess_prev "    Result UsbSession::GetTransferResult(UsbSessionEndpoint ep, u32 urb_id, u32 *out_transferred_size) {\n        UsbDsReportData report_data;\n\n        R_TRY(eventClear(std::addressof(m_endpoints[ep]->CompletionEvent)));\n        R_TRY(usbDsEndpoint_GetReportData(m_endpoints[ep], std::addressof(report_data)));\n        const Result parse_res = usbDsParseReportData(std::addressof(report_data), urb_id, nullptr, out_transferred_size);\n        if (parse_res == 0x748C) {\n            R_THROW(haze::ResultCancelled());\n        }\n        R_RETURN(parse_res);\n    }")
        set(usb_sess_prev2 "    Result UsbSession::GetTransferResult(UsbSessionEndpoint ep, u32 urb_id, u32 *out_transferred_size) {\n        UsbDsReportData report_data;\n\n        R_TRY(eventClear(std::addressof(m_endpoints[ep]->CompletionEvent)));\n        R_TRY(usbDsEndpoint_GetReportData(m_endpoints[ep], std::addressof(report_data)));\n        const Result parse_res = usbDsParseReportData(std::addressof(report_data), urb_id, nullptr, out_transferred_size);\n        if (parse_res == 0x748C) {\n            R_THROW(haze::ResultCancelled());\n        }\n        R_RETURN(parse_res);\n    }\n\n    Result UsbSession::CancelEndpoint(UsbSessionEndpoint ep, u32 urb_id) {\n        if (!m_endpoints[ep]) {\n            R_SUCCEED();\n        }\n        usbDsEndpoint_Cancel(m_endpoints[ep]);\n        eventWait(std::addressof(m_endpoints[ep]->CompletionEvent), 1000000000ULL);\n        u32 transferred = 0;\n        this->GetTransferResult(ep, urb_id, std::addressof(transferred));\n        R_SUCCEED();\n    }")

        set(usb_sess_new "    Result UsbSession::GetTransferResult(UsbSessionEndpoint ep, u32 urb_id, u32 *out_transferred_size) {\n        UsbDsReportData report_data;\n\n        R_TRY(eventClear(std::addressof(m_endpoints[ep]->CompletionEvent)));\n        R_TRY(usbDsEndpoint_GetReportData(m_endpoints[ep], std::addressof(report_data)));\n        const Result parse_res = usbDsParseReportData(std::addressof(report_data), urb_id, nullptr, out_transferred_size);\n        if (parse_res == 0x748C) {\n            R_THROW(haze::ResultCancelled());\n        }\n        R_RETURN(parse_res);\n    }\n\n    Result UsbSession::CancelEndpoint(UsbSessionEndpoint ep, u32 urb_id) {\n        R_UNLESS(m_endpoints[ep], haze::ResultInvalidArgument());\n\n        /* Request hardware cancellation of in-flight URBs on endpoint. */\n        R_TRY(usbDsEndpoint_Cancel(m_endpoints[ep]));\n\n        /* Wait for driver to signal completion event after cancel (bounded to 1s). */\n        R_TRY(eventWait(std::addressof(m_endpoints[ep]->CompletionEvent), 1000000000ULL));\n\n        /* Harvest report to ensure URB retirement and clear endpoint completion state. */\n        u32 transferred = 0;\n        const Result res = this->GetTransferResult(ep, urb_id, std::addressof(transferred));\n        if (res == haze::ResultCancelled() || R_SUCCEEDED(res)) {\n            R_SUCCEED();\n        }\n\n        R_RETURN(res);\n    }")

        string(FIND "${src}" "${usb_sess_prev2}" find_prev2)
        string(FIND "${src}" "${usb_sess_prev}" find_prev)
        if(NOT find_prev2 EQUAL -1)
            string(REPLACE "${usb_sess_prev2}" "${usb_sess_new}" src "${src}")
        elseif(NOT find_prev EQUAL -1)
            string(REPLACE "${usb_sess_prev}" "${usb_sess_new}" src "${src}")
        else()
            string(REPLACE "${usb_sess_old}" "${usb_sess_new}" src "${src}")
        endif()

        string(FIND "${src}" "parse_res == 0x748C" find_urb_cancel_after)
        string(FIND "${src}" "res == haze::ResultCancelled() || R_SUCCEEDED(res)" find_ce_after)
        string(FIND "${src}" "${dup_ce}" find_dup_final)
        if(find_urb_cancel_after EQUAL -1 OR find_ce_after EQUAL -1 OR NOT find_dup_final EQUAL -1)
            message(FATAL_ERROR "[libhaze-patch] failed to apply cancel patch to usb_session.cpp")
        endif()
        file(WRITE "source/usb_session.cpp" "${src}")
        message(STATUS "[libhaze-patch] applied usb_session.cpp cancel patch")
    endif()
else()
    message(FATAL_ERROR "[libhaze-patch] source/usb_session.cpp not found")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/patch_libhaze_cleanup.cmake")
